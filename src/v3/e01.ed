/* Tune-up inputs: keep typed numbers across re-renders. */
function captureTune() {
  if (!data.tuneup) data.tuneup = { answers: {}, photos: {} };
  const v = id => { const el = document.getElementById(id); return el ? el.value.trim() : null; };
  const h = v("tu-height"); if (h != null) data.golferHeightIn = h;
  const w = v("tu-wrist"); if (w != null) data.tuneup.wristFloorIn = w;
  const hand = v("tu-hand"); if (hand != null) data.tuneup.handIn = hand;
  const l7 = v("tu-len7"); if (l7 != null) data.tuneup.len7 = l7;
  const ld = v("tu-lendr"); if (ld != null) data.tuneup.lenDR = ld;
  const pu = v("tu-putter"); if (pu != null) data.putterLengthIn = pu;
}

