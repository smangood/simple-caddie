    case "whatsnew-ok": data.whatsNewSeen = "3.0"; save(); render(); break;
    case "focus-toggle": {
      const id = t.dataset.id; const f = data.focus || [];
      data.focus = f.includes(id) ? f.filter(x => x !== id) : f.concat(id);
      ui.learnTab = null; save(); render(); break;
    }
    case "focus-clear": data.focus = []; ui.learnTab = null; save(); render(); break;
    case "go-athome": ui.athomeBack = t.dataset.back || "pro"; go("athome"); break;
    case "home-done": {
      data.homeDrillLog = [{ date: today(), id: t.dataset.id }].concat(data.homeDrillLog || []).slice(0, 200);
      save(); ui.flash = "Logged. That's practice — it counts."; render(); break;
    }
    case "budget-rounds": data.budget = Object.assign({}, data.budget, { rounds: data.budget && data.budget.rounds === t.dataset.v ? "" : t.dataset.v }); save(); render(); break;
    case "budget-goal": data.budget = Object.assign({}, data.budget, { goal: data.budget && data.budget.goal === t.dataset.v ? "" : t.dataset.v }); ui.guideTier = null; save(); render(); break;
    case "guide-tier": ui.guideTier = t.dataset.v; render(); break;
    case "tune-glove": captureTune(); data.tuneup.glove = data.tuneup.glove === t.dataset.v ? "" : t.dataset.v; save(); render(); break;
    case "tune-ans": {
      captureTune();
      const a = data.tuneup.answers; a[t.dataset.qid] = a[t.dataset.qid] === t.dataset.v ? "" : t.dataset.v;
      save(); render(); break;
    }
    case "tune-save": captureTune(); save(); ui.flash = "Measurements saved."; render(); break;
